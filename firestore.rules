rules_version = '2';

// ============================================================
//  Правила доступа Firestore.
//  Перед публикацией замените ANNA_EMAIL и TANYA_EMAIL на
//  реальные адреса и вставьте текст в Firebase Console →
//  Firestore Database → Rules → Publish.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return userEmail() == 'mudro.is@yandex.ru';
    }

    function isTeacher() {
      return userEmail() == 'english.i.s@yandex.ru';
    }

    // Расписания: документы anna и tanya ({schedule, times})
    match /schedules/{owner} {
      allow get, list: if isAdmin() || (isTeacher() && owner == 'tanya');
      allow create, update: if isAdmin() || (isTeacher() && owner == 'tanya');
      allow delete: if false;
    }

    // Задачи: документы anna и tanya ({tasks})
    match /tasks/{owner} {
      allow get, list: if isAdmin() || (isTeacher() && owner == 'tanya');
      allow create, update: if isAdmin() || (isTeacher() && owner == 'tanya');
      allow delete: if false;
    }

    // Всё остальное — запрещено
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
